# Slack App Tokens
SLACK_APP_TOKEN=xapp-1-...
SLACK_BOT_TOKEN=xoxb-...

# Slack Channel (name or ID)
SLACK_CHANNEL=ai-approvals

# Approver User ID (from Slack profile > Copy member ID)
SLACK_APPROVER_USER_ID=U...

# Timeouts (seconds, 30-3600, default: 300)
# PERMISSION_TIMEOUT_SEC=300
# ASK_QUESTION_TIMEOUT_SEC=300

# Default working directory for /claude slash command sessions (default: ".")
# DEFAULT_CWD=.
