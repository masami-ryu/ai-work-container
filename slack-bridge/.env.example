# Slack App-Level Token (xapp-...)
SLACK_APP_TOKEN=xapp-...

# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-...

# Slack channel for approval messages
SLACK_CHANNEL=ai-approvals

# Slack user ID of the approver (U...)
SLACK_APPROVER_USER_ID=U...

# Permission confirmation timeout (seconds, default: 300)
PERMISSION_TIMEOUT_SEC=300

# AskUserQuestion timeout (seconds, default: 300)
ASK_QUESTION_TIMEOUT_SEC=300

# Authentication: Run `claude login` with the bundled CLI (Max plan OAuth).
# No ANTHROPIC_API_KEY needed.
